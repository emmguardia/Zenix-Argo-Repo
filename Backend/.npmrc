# Défense supply-chain : refuse tout paquet publié il y a moins de 24h.
# Voir Frontend/.npmrc pour le détail du choix.
minimum-release-age=1440

engine-strict=true

fund=false
audit=false
update-notifier=false

# Empêche pnpm d'exécuter les scripts post-install des dépendances sans approbation
# explicite. Critique côté backend qui tourne avec des secrets.
ignore-scripts=true
