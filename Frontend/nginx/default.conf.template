# Configuration nginx du frontend Zenix.
#
# Ce fichier est un TEMPLATE : au démarrage, l'entrypoint de l'image substitue
# ${NGINX_LOCAL_RESOLVERS} (rempli depuis le /etc/resolv.conf du pod) et écrit
# le résultat dans /etc/nginx/conf.d/default.conf.
#
# Le TLS est terminé en amont (Cloudflare + Traefik) : ce serveur ne parle qu'en
# HTTP en interne. HSTS est posé par le middleware Traefik `security-headers`,
# il n'a donc pas à être dupliqué ici.
#
# Le conteneur tourne en non-root (image nginx-unprivileged), d'où le port 8080 :
# un process non privilégié ne peut pas se binder sur un port < 1024.

server {
    listen 8080;
    server_name zenixweb.fr www.zenixweb.fr;
    root /usr/share/nginx/html;
    index index.html;

    # Ne pas divulguer la version de nginx dans les réponses et les pages d'erreur.
    server_tokens off;

    # Redirections relatives (Location: /page). nginx construit sinon une URL
    # absolue à partir du port d'écoute interne, ce qui donnerait
    # « http://zenixweb.fr:8080/... » derrière Traefik : mauvais schéma et
    # mauvais port. Une Location relative laisse le navigateur conserver le
    # schéma, l'hôte et le port d'origine.
    absolute_redirect off;

    # Résolveur DNS du cluster, injecté au démarrage. Indispensable pour que le
    # proxy_pass ci-dessous résolve le backend à chaque requête plutôt qu'une
    # seule fois au chargement de la config.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    resolver_timeout 5s;

    # Bloque l'accès aux fichiers et dossiers commençant par un point
    # (.env, .git, .htaccess...). On renvoie 404 plutôt que 403 pour ne pas
    # confirmer leur existence.
    location ~ /\. {
        deny all;
        return 404;
    }

    # ── Assets statiques ─────────────────────────────────────────────────────
    # Images : rarement modifiées, cache 1 an.
    location ^~ /images/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # JS/CSS : le nom contient un hash de contenu, donc immuable.
    location ^~ /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ~ ^/(sitemap\.xml|robots\.txt)$ {
        include /etc/nginx/snippets/security-headers.conf;
        access_log off;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    # ── API ──────────────────────────────────────────────────────────────────
    # L'hôte passe par une variable À DESSEIN. Avec un nom littéral, nginx
    # résout le DNS au chargement de la config et REFUSE DE DÉMARRER si le nom
    # est introuvable : une indisponibilité du Service backend faisait donc
    # tomber tout le site, pages statiques comprises. Via une variable, la
    # résolution a lieu par requête : si le backend est absent, seul /api/
    # renvoie 502, le reste du site continue de répondre.
    #
    # Effet de bord d'un proxy_pass avec variable : nginx ne réécrit plus l'URI,
    # il faut donc la passer explicitement — $request_uri conserve le chemin
    # complet et la query string.
    location /api/ {
        set $zenix_backend "zenix-backend.zenix.svc.cluster.local";
        proxy_pass http://$zenix_backend:3000$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
    }

    # ── Normalisation des URL ────────────────────────────────────────────────
    # /hebergement/ et /hebergement serviraient le même contenu sous deux URL
    # distinctes. On redirige vers la forme sans slash final, celle déclarée en
    # canonical et dans le sitemap.
    location ~ ^(/.+)/$ {
        return 301 $1;
    }

    # ── Pages ────────────────────────────────────────────────────────────────
    # Le build génère un dossier par route (dist/hebergement/index.html, ...)
    # contenant les balises SEO propres à la page. Ces fichiers tiennent lieu de
    # liste de routes : plus aucune énumération à maintenir ici, donc plus de
    # divergence possible avec src/config/routes.ts. Une URL sans dossier
    # correspondant tombe naturellement en 404, ce qui est le comportement voulu.
    #
    # Pas de X-Robots-Tag : « index, follow » étant le comportement par défaut,
    # l'envoyer explicitement n'apporte rien et entrerait en conflit avec le
    # noindex de la page de confirmation.
    location = / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files /index.html =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri $uri/index.html =404;
    }

    # ── 404 ──────────────────────────────────────────────────────────────────
    # Sans `=` devant la cible, nginx CONSERVE le statut 404 tout en servant le
    # contenu de 404.html : le visiteur voit la page 404 React, et Google reçoit
    # un vrai code 404 au lieu d'un « soft 404 » en 200 qu'il indexerait.
    error_page 404 /spa-404;

    location = /spa-404 {
        internal;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files /404.html /index.html =404;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json image/svg+xml;
}
